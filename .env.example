# ---- Runtime ----
NODE_ENV=development
API_PORT=4000
# Comma-separated list of origins allowed by CORS (the web app).
WEB_ORIGIN=http://localhost:5173
# Public URL of the web app, used to build password-reset links.
APP_URL=http://localhost:5173

# ---- Database ----
# Local development defaults match `pnpm db:start` (embedded PostgreSQL, localhost only).
# Production: use your own credentials and a least-privilege role (docs/DEPLOYMENT.md).
DATABASE_URL=postgresql://qtm:qtm_dev_password@localhost:5432/qtm_dev?schema=public
# Used only by the integration test suite. Never point it at a real database.
TEST_DATABASE_URL=postgresql://qtm:qtm_dev_password@localhost:5432/qtm_test?schema=public

# ---- Sessions ----
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_TTL_DAYS=7
# Set to true when served over HTTPS (required in production).
COOKIE_SECURE=false

# ---- File storage ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# ---- AI assistant (optional) ----
# Provider: anthropic | none (adapters implement AiProvider; see docs/AI.md)
AI_PROVIDER=none
AI_MODEL=
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT_PER_USER=50
AI_DAILY_LIMIT_PER_ORG=500

# ---- Logging ----
LOG_LEVEL=info

# ---- Access ----
# Set to false for private deployments; create accounts with `pnpm --filter @qtm/api admin:create`.
REGISTRATION_ENABLED=true
