# Used by: docker compose --env-file .env.docker up --build
POSTGRES_USER=qtm_owner
POSTGRES_PASSWORD=change_me_owner
APP_DB_USER=qtm_app
APP_DB_PASSWORD=change_me_app
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
APP_URL=http://localhost:8080
# Session cookies require HTTPS when true. Set to false ONLY for local HTTP testing.
COOKIE_SECURE=true
AI_PROVIDER=none
AI_MODEL=
ANTHROPIC_API_KEY=
